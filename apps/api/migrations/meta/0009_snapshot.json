      "checkConstraints": {
        "accounts_credentials_match_type": {
          "name": "accounts_credentials_match_type",
          "value": "\n        (\"accounts\".\"account_type\" = 'local'\n          AND \"accounts\".\"phone\" IS NOT NULL AND \"accounts\".\"pin_hash\" IS NOT NULL\n          AND \"accounts\".\"email\" IS NULL AND \"accounts\".\"password_hash\" IS NULL)\n        OR\n        (\"accounts\".\"account_type\" = 'institutional'\n          AND \"accounts\".\"email\" IS NOT NULL AND \"accounts\".\"password_hash\" IS NOT NULL\n          AND \"accounts\".\"phone\" IS NULL AND \"accounts\".\"pin_hash\" IS NULL)\n      "
        },
        "accounts_role_matches_account_type": {
          "name": "accounts_role_matches_account_type",
          "value": "\n        (\"accounts\".\"role\" IN ('treasurer', 'clerk', 'pastor') AND \"accounts\".\"account_type\" = 'local')\n        OR\n        (\"accounts\".\"role\" IN ('mission_admin', 'mission_staff', 'platform_operator')\n          AND \"accounts\".\"account_type\" = 'institutional')\n      "
        },
        "accounts_scope_matches_role": {
          "name": "accounts_scope_matches_role",
          "value": "\n        (\"accounts\".\"role\" IN ('treasurer', 'clerk')\n          AND \"accounts\".\"church_id\" IS NOT NULL AND \"accounts\".\"district_id\" IS NULL AND \"accounts\".\"mission_id\" IS NULL)\n        OR\n        (\"accounts\".\"role\" = 'pastor'\n          AND \"accounts\".\"district_id\" IS NOT NULL AND \"accounts\".\"church_id\" IS NULL AND \"accounts\".\"mission_id\" IS NULL)\n        OR\n        (\"accounts\".\"role\" IN ('mission_admin', 'mission_staff')\n          AND \"accounts\".\"mission_id\" IS NOT NULL AND \"accounts\".\"church_id\" IS NULL AND \"accounts\".\"district_id\" IS NULL)\n        OR\n        (\"accounts\".\"role\" = 'platform_operator'\n          AND \"accounts\".\"church_id\" IS NULL AND \"accounts\".\"district_id\" IS NULL AND \"accounts\".\"mission_id\" IS NULL)\n      "
        }
      }
    },
