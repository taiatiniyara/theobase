      "checkConstraints": {
        "reconciliations_status_progression": {
          "name": "reconciliations_status_progression",
          "value": "\n        (\"reconciliations\".\"status\" = 'submitted'\n          AND \"reconciliations\".\"sent_at\" IS NULL AND \"reconciliations\".\"sent_by_account_id\" IS NULL\n          AND \"reconciliations\".\"received_at\" IS NULL AND \"reconciliations\".\"received_by_account_id\" IS NULL)\n        OR\n        (\"reconciliations\".\"status\" = 'in_transit'\n          AND \"reconciliations\".\"sent_at\" IS NOT NULL AND \"reconciliations\".\"sent_by_account_id\" IS NOT NULL\n          AND \"reconciliations\".\"received_at\" IS NULL AND \"reconciliations\".\"received_by_account_id\" IS NULL)\n        OR\n        (\"reconciliations\".\"status\" = 'received'\n          AND \"reconciliations\".\"sent_at\" IS NOT NULL AND \"reconciliations\".\"sent_by_account_id\" IS NOT NULL\n          AND \"reconciliations\".\"received_at\" IS NOT NULL AND \"reconciliations\".\"received_by_account_id\" IS NOT NULL)\n      "
        },
        "reconciliations_discrepancy_requires_received": {
          "name": "reconciliations_discrepancy_requires_received",
          "value": "\"reconciliations\".\"has_discrepancy\" = 0 OR \"reconciliations\".\"status\" = 'received'"
        },
        "reconciliations_resolution_requires_discrepancy": {
          "name": "reconciliations_resolution_requires_discrepancy",
          "value": "\"reconciliations\".\"discrepancy_proposed_by_account_id\" IS NULL OR \"reconciliations\".\"has_discrepancy\" = 1"
        },
        "reconciliations_resolution_confirmed_requires_proposed": {
          "name": "reconciliations_resolution_confirmed_requires_proposed",
          "value": "\"reconciliations\".\"discrepancy_confirmed_by_account_id\" IS NULL OR \"reconciliations\".\"discrepancy_proposed_by_account_id\" IS NOT NULL"
        },
        "reconciliations_resolution_confirmer_differs_from_proposer": {
          "name": "reconciliations_resolution_confirmer_differs_from_proposer",
          "value": "\"reconciliations\".\"discrepancy_confirmed_by_account_id\" IS NULL\n        OR \"reconciliations\".\"discrepancy_confirmed_by_account_id\" != \"reconciliations\".\"discrepancy_proposed_by_account_id\""
        },
        "reconciliations_resolved_at_requires_confirmed": {
          "name": "reconciliations_resolved_at_requires_confirmed",
          "value": "\"reconciliations\".\"discrepancy_resolved_at\" IS NULL OR \"reconciliations\".\"discrepancy_confirmed_by_account_id\" IS NOT NULL"
        }
      }
