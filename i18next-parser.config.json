{
  "locales": ["en", "hif"],
  "output": "packages/web/src/i18n/$LOCALE/$NAMESPACE.json",
  "input": [
    "packages/web/src/**/*.{ts,tsx}",
    "packages/web/src/i18n/**/*.json"
  ],
  "fallbackLocale": "en",
  "keySeparator": ".",
  "namespaceSeparator": ":",
  "defaultNamespace": "common",
  "sort": true,
  "createOldCatalogs": false,
  "keepRemoved": false
}
