{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theobase",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theobase",
      "database_id": "207a2c28-c081-4c33-8541-4fd29a8dcac4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHURCH_SYNC_DO",
        "class_name": "ChurchSyncDO",
      },
      {
        "name": "CONFERENCE_DO",
        "class_name": "ConferenceDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChurchSyncDO", "ConferenceDO"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 0 1 * *"],
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "theobase-metrics",
    },
  ],
  "env": {
    "staging": {
      "name": "theobase-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theobase-staging",
          "database_id": "theobase-staging",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
