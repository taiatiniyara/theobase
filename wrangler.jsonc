{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theobase",
  "account_id": "2e2276433c73f18451f3f2fd50adddb7",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theobase",
      "database_id": "207a2c28-c081-4c33-8541-4fd29a8dcac4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHURCH_SYNC_DO",
        "class_name": "ChurchSyncDO",
      },
      {
        "name": "CONFERENCE_DO",
        "class_name": "ConferenceDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChurchSyncDO", "ConferenceDO"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 0 1 * *"],
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "theobase-metrics",
    },
  ],
  "env": {
    "staging": {
      "name": "theobase-staging",
      "routes": [{ "pattern": "staging.theobase.app", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
      },
      "durable_objects": {
        "bindings": [
          { "name": "CHURCH_SYNC_DO", "class_name": "ChurchSyncDO" },
          { "name": "CONFERENCE_DO", "class_name": "ConferenceDO" },
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "theobase-metrics-staging" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theobase-staging",
          "database_id": "d6d62909-ab22-41b2-9fce-44b850ab55e2",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "theobase-production",
      "routes": [
        { "pattern": "theobase.app", "custom_domain": true },
        { "pattern": "www.theobase.app", "custom_domain": true },
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
      },
      "durable_objects": {
        "bindings": [
          { "name": "CHURCH_SYNC_DO", "class_name": "ChurchSyncDO" },
          { "name": "CONFERENCE_DO", "class_name": "ConferenceDO" },
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "theobase-metrics" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "theobase-production",
          "database_id": "71a5cc99-e10a-4eca-8016-953cf117fa0f",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
