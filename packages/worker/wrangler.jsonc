{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "theobase-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHURCH_DO",
        "class_name": "ChurchDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChurchDO"],
    },
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "REPLACE_ME_run_wrangler_kv_namespace_create_theobase_auth_and_paste_id_here",
    },
  ],
  "vars": {
    "APP_URL": "https://theobase.pages.dev",
  },
}
