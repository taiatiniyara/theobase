{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "theobase-worker",
  "account_id": "2e2276433c73f18451f3f2fd50adddb7",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHURCH_DO",
        "class_name": "ChurchDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChurchDO"],
    },
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "remote": true,
    },
  ],
  "vars": {
    "APP_URL": "https://theobase.app",
  },
  "triggers": {
    "crons": ["0 0 1 * *"],
  },
  "kv_namespaces": [
    {
      "binding": "theobase_auth",
      "id": "db7f506e520c46c7a53e46eb70735929",
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theobase",
      "database_id": "030a7b51-45c8-465f-924d-0b547cd63997",
      "migrations_dir": "drizzle",
    },
  ],
}
