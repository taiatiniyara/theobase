{
  "name": "theobase-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "theobase-auth",
    },
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
    },
  ],
  "vars": {
    "APP_URL": "http://localhost:8787",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHURCH_DO",
        "class_name": "ChurchDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChurchDO"],
    },
  ],
}
